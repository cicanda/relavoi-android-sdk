# Copy this file to `secrets.properties` (gitignored) and fill in your own
# workspace's values. Generate sandbox keys on the API & Keys page of the
# dashboard; the workspace id is the Workspace ID field at the top of the
# same page. See README.md.
RELAVOI_API_KEY=YOUR_API_KEY
RELAVOI_API_SECRET=YOUR_API_SECRET
RELAVOI_TENANT_ID=YOUR_TENANT_ID
RELAVOI_BASE_URL=https://api.relavoi.com/v1
